# PayFast + Fire-S — server secrets only
#
# Copy values into the Supabase project that hosts the Edge Functions:
#   Dashboard → Edge Functions → Secrets
# or: supabase secrets set --env-file .env
#
# NEVER prefix these with VITE_, NEXT_PUBLIC_, or REACT_APP_.
# NEVER put merchant key or passphrase in fire-s-env.js / the PWA.
# Do not commit a filled-in .env file.

# sandbox | live
# Default is sandbox. Live is refused unless PAYFAST_ALLOW_LIVE=true.
PAYFAST_MODE=sandbox
PAYFAST_ALLOW_LIVE=false

# --- Sandbox (toets / development) ---
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
# Optional. Sandbox checkout email — must not be the merchant account email.
# PAYFAST_SANDBOX_BUYER_EMAIL=fires-toets-buyer@example.com
# Optional override. Default: https://sandbox.payfast.co.za/eng/process
# PAYFAST_SANDBOX_PROCESS_URL=
# Optional override. Default: https://sandbox.payfast.co.za/eng/query/validate
# PAYFAST_SANDBOX_VALIDATE_URL=

# --- Live (production Supabase project only) ---
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_LIVE_PASSPHRASE=
# Optional override. Default: https://www.payfast.co.za/eng/process
# PAYFAST_LIVE_PROCESS_URL=
# Optional override. Default: https://www.payfast.co.za/eng/query/validate
# PAYFAST_LIVE_VALIDATE_URL=

# Fire-S public app URL (used to build return/cancel if those are empty)
# Toets: https://georgevdx.github.io/fire-s-online-app/staging/index.html
# Live:  https://georgevdx.github.io/fire-s-online-app/index.html
FIRE_S_PUBLIC_URL=

# Optional explicit PayFast URLs. Empty = derived from FIRE_S_PUBLIC_URL / SUPABASE_URL.
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
PAYFAST_NOTIFY_URL=

# Injected automatically on Supabase Edge Functions. Set locally if you run Deno.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
